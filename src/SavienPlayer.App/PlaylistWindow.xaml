<Window x:Class="SavienPlayer.App.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Playlist"
        Width="280"
        Height="380"
        MinWidth="200"
        MinHeight="220"
        WindowStyle="None"
        Background="#141414"
        Foreground="White"
        FontSize="5">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="IconControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#383838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1C1C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2A2A2A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="CustomTitleBar"
                    Grid.Row="0"
                    Height="16"
                    Background="#1A1A1A"
                    BorderBrush="#2A2A2A"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="CustomTitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="플레이리스트"
                               FontSize="5"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               IsHitTestVisible="False"/>

                    <Button Grid.Column="1"
                            Width="24"
                            Height="16"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#CCCCCC"
                            Padding="0"
                            ToolTip="닫기"
                            Click="CloseWindowButton_OnClick">
                        <Path Data="M 0,0 L 6,6 M 6,0 L 0,6"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              Stretch="None"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <ListBox x:Name="PlaylistListBox"
                     Grid.Row="1"
                     Margin="6,6,6,4"
                     Background="#1B1B1B"
                     BorderBrush="#2A2A2A"
                     BorderThickness="1"
                     Foreground="White"
                     FontSize="10"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="PlaylistListBox_OnMouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="5"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding FileName}"
                                       FontSize="5"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DurationText}"
                                       FontSize="5"
                                       Foreground="#BBBBBB"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="6,2,6,6">
                <Button Style="{StaticResource IconControlButtonStyle}"
                        Margin="0,0,6,0"
                        ToolTip="목록 추가"
                        AutomationProperties.Name="목록 추가"
                        Click="AddItemButton_OnClick">
                    <Path Data="M 6,1 V 11 M 1,6 H 11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          Stretch="Uniform"
                          Width="11"
                          Height="11"/>
                </Button>
                <Button Style="{StaticResource IconControlButtonStyle}"
                        Margin="0,0,6,0"
                        ToolTip="목록 삭제"
                        AutomationProperties.Name="목록 삭제"
                        Click="RemoveItemButton_OnClick">
                    <Path Data="M 1,6 H 11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          Stretch="Uniform"
                          Width="11"
                          Height="1"/>
                </Button>
                <Button Style="{StaticResource IconControlButtonStyle}"
                        ToolTip="목록 불러오기"
                        AutomationProperties.Name="목록 불러오기"
                        Click="LoadPlaylistButton_OnClick">
                    <Path Data="M 0,2 H 5 L 6.5,3.5 H 12 V 10 H 0 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform"
                          Width="12"
                          Height="12"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
