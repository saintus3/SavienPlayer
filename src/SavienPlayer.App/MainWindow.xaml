<Window x:Class="SavienPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Title="SavienPlayer" Height="680" Width="1100" MinWidth="900" MinHeight="560"
        Background="#111111" Foreground="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="8" Background="#1B1B1B" BorderBrush="#2A2A2A" BorderThickness="1">
                <vlc:VideoView x:Name="VideoView"/>
            </Border>
            <DockPanel Grid.Column="1" Margin="10,0,0,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="플레이리스트" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="파일 추가" Padding="8,4" Click="AddFilesButton_OnClick"/>
                        <Button Content="선택 삭제" Padding="8,4" Margin="8,0,0,0" Click="RemoveFilesButton_OnClick"/>
                        <Button Content="다음" Padding="8,4" Margin="8,0,0,0" Click="NextButton_OnClick"/>
                    </StackPanel>
                    <CheckBox x:Name="AllowDuplicatesBox" Content="중복 추가 허용" Margin="0,0,0,8"
                              Checked="AllowDuplicatesBox_OnChanged" Unchecked="AllowDuplicatesBox_OnChanged"/>
                    <TextBlock Text="더블클릭: 재생 · 드래그: 순서 변경" FontSize="11" Margin="0,0,0,8"/>
                </StackPanel>
                <ListBox x:Name="PlaylistList" SelectionMode="Extended" AllowDrop="True"
                         Background="#1B1B1B" Foreground="White"
                         PreviewMouseLeftButtonDown="PlaylistList_OnPreviewMouseLeftButtonDown"
                         PreviewMouseMove="PlaylistList_OnPreviewMouseMove"
                         MouseDoubleClick="PlaylistList_OnMouseDoubleClick"
                         DragOver="PlaylistList_OnDragOver" Drop="PlaylistList_OnDrop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FilePath}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#55DD99"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Slider x:Name="SeekBar" Minimum="0" Maximum="100" Value="0" Height="24"
                    PreviewMouseUp="SeekBar_OnPreviewMouseUp"/>

            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="열기" Width="70" Margin="0,0,8,0" Click="OpenButton_OnClick"/>
                    <Button Content="재생" Width="70" Margin="0,0,8,0" Click="PlayButton_OnClick"/>
                    <Button Content="일시정지" Width="80" Margin="0,0,8,0" Click="PauseButton_OnClick"/>
                    <Button Content="정지" Width="70" Click="StopButton_OnClick"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="볼륨" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeBar" Width="120" Minimum="0" Maximum="100" Value="70"
                            ValueChanged="VolumeBar_OnValueChanged"/>
                    <Button Content="전체화면" Width="90" Margin="10,0,0,0" Click="FullscreenButton_OnClick"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="자막 열기" Width="90" Margin="0,0,8,0" Click="OpenSubtitleButton_OnClick"/>
                    <Button Content="자막 해제" Width="90" Margin="0,0,8,0" Click="ClearSubtitleButton_OnClick"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="자막 싱크(ms)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SubtitleOffsetBox" Width="90" Text="0" Margin="0,0,8,0"/>
                    <Button Content="적용" Width="60" Click="ApplySubtitleOffsetButton_OnClick"/>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="SubtitleStatusText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.85"
                       Text="자막: 없음"/>
        </StackPanel>
    </Grid>
</Window>
