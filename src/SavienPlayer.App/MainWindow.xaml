<Window x:Class="SavienPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:SavienPlayer.App"
        mc:Ignorable="d"
        Title="SavienPlayer" Height="680" Width="1100" MinWidth="900" MinHeight="560"
        Background="#111111" Foreground="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="8" Background="#1B1B1B" BorderBrush="#2A2A2A" BorderThickness="1">
            <vlc:VideoView x:Name="VideoView">
                <local:SubtitleOverlay x:Name="SubtitleDisplay" IsHitTestVisible="False"
                                       ClipToBounds="True"/>
            </vlc:VideoView>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Slider x:Name="SeekBar" Minimum="0" Maximum="100" Value="0" Height="24"
                    PreviewMouseUp="SeekBar_OnPreviewMouseUp"/>

            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="열기" Width="70" Margin="0,0,8,0" Click="OpenButton_OnClick"/>
                    <Button Content="재생" Width="70" Margin="0,0,8,0" Click="PlayButton_OnClick"/>
                    <Button Content="일시정지" Width="80" Margin="0,0,8,0" Click="PauseButton_OnClick"/>
                    <Button Content="정지" Width="70" Click="StopButton_OnClick"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="볼륨" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeBar" Width="120" Minimum="0" Maximum="100" Value="70"
                            ValueChanged="VolumeBar_OnValueChanged"/>
                    <CheckBox x:Name="MuteToggle" Content="음소거 (M)" VerticalAlignment="Center" Margin="8,0,0,0"
                              Checked="MuteToggle_OnChanged" Unchecked="MuteToggle_OnChanged"/>
                    <Button Content="전체화면" Width="90" Margin="10,0,0,0" Click="FullscreenButton_OnClick"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="재생속도" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="PlaybackRateBar" Width="140" Minimum="0.25" Maximum="4" Value="1"
                        TickFrequency="0.25" IsSnapToTickEnabled="True"
                        ValueChanged="PlaybackRateBar_OnValueChanged"/>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding Value, ElementName=PlaybackRateBar, StringFormat={}{0:0.##}×}"/>
            </StackPanel>

            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="자막 열기" Width="90" Margin="0,0,8,0" Click="OpenSubtitleButton_OnClick"/>
                    <Button Content="자막 해제" Width="90" Margin="0,0,8,0" Click="ClearSubtitleButton_OnClick"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="자막 싱크(ms)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SubtitleOffsetBox" Width="90" Text="0" Margin="0,0,8,0"/>
                    <Button Content="−100" Width="55" Margin="0,0,4,0" Click="SubtitleEarlier_OnClick"
                            ToolTip="자막을 100ms 일찍 (Ctrl+[)"/>
                    <Button Content="+100" Width="55" Margin="0,0,4,0" Click="SubtitleLater_OnClick"
                            ToolTip="자막을 100ms 늦게 (Ctrl+])"/>
                    <Button Content="적용" Width="60" Click="ApplySubtitleOffsetButton_OnClick"/>
                </StackPanel>
            </DockPanel>

            <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="자막 글꼴" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SubtitleFontBox" Width="150" DisplayMemberPath="Source"
                          SelectionChanged="SubtitleStyle_OnSelectionChanged"/>
                <TextBlock Text="크기" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <Slider x:Name="SubtitleSizeBar" Width="95" Minimum="12" Maximum="96" Value="32"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SubtitleStyle_OnValueChanged"/>
                <TextBlock Text="외곽선" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <Slider x:Name="SubtitleOutlineBar" Width="80" Minimum="0" Maximum="6" Value="2"
                        TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="SubtitleStyle_OnValueChanged"/>
                <TextBlock Text="위치" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <ComboBox x:Name="SubtitlePositionBox" Width="75" SelectedIndex="2"
                          SelectionChanged="SubtitleStyle_OnSelectionChanged">
                    <ComboBoxItem Content="위" Tag="Top"/>
                    <ComboBoxItem Content="가운데" Tag="Center"/>
                    <ComboBoxItem Content="아래" Tag="Bottom"/>
                </ComboBox>
                <CheckBox x:Name="SubtitleOriginalStyleBox" Content="원본 스타일 (VLC)"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          Checked="SubtitleOriginalStyle_OnChanged" Unchecked="SubtitleOriginalStyle_OnChanged"/>
            </WrapPanel>

            <TextBlock x:Name="SubtitleStatusText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.85"
                       Text="자막: 없음"/>
        </StackPanel>
    </Grid>
</Window>
